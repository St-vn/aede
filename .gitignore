# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# venv
.venv/
venv/

# build / scripts
*.exe

# node (only present when MCP plugins pull JS deps; never aede's own)
node_modules/

# Playwright MCP scratch — screenshots, page snapshots, console/network dumps
# left in the repo root by the browser MCP plugin during sessions. Never source.
.playwright-mcp/

# Scratch dump — dev screenshots, session transcripts, browser captures, and
# loose planning notes corralled out of the repo root. Never source; kept on
# disk for reference but never committed.
/_scratch/

# env
.env

# credentials vault (aede owns ~/.aede/credentials.json; ignore defensively)
credentials.json

# ---------------------------------------------------------------
# PRIVATE / INTERNAL — never commit to the public repo
# ---------------------------------------------------------------
# Claude Code workspace config (settings, hooks, memory, skills)
.claude/
# Root-level CLAUDE.md (project instructions with internal notes)
/CLAUDE.md
# .claudeignore (Claude Code ignore list — internal tooling config)
/.claudeignore
# Private planning docs (PRD/roadmap scratch — internal only)
/docs/plans/
# sdlc-engineer artifacts (spec/design/tasks scratch — internal only)
/docs/sdlc-engineer/

# Internal docs — not for the public repo (developer-facing only)
/docs-internal/

